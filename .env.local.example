# Copy to `.env.local` and uncomment the provider(s) you want to hit.
# The /providers page auto-activates the first one that has a key set.

# --- app flags -------------------------------------------------------------
VITE_AUTH_ENABLED=false

# --- built-in providers ----------------------------------------------------
# xAI (Grok) — default target
# XAI_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic (Claude)
# ANTHROPIC_API_KEY=

# Google (Gemini)
# GOOGLE_API_KEY=

# OpenRouter (routes to any upstream model by slug)
# OPENROUTER_API_KEY=

# Groq
# GROQ_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Together
# TOGETHER_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Fireworks
# FIREWORKS_API_KEY=

# NVIDIA NIM
# NVIDIA_API_KEY=

# Ollama and LM Studio don't need a key (localhost).
